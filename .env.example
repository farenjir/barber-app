# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_random_secret_here
BOT_USERNAME=BarberAppointmentAppBot

# Admin Configuration (comma-separated Telegram user IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Database (Neon Postgres or other PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Web Application URL (for magic link authentication)
# Use your Vercel deployment URL or custom domain
# Examples:
#   - Production: https://your-domain.com
#   - Vercel: https://your-project.vercel.app
#   - Local dev: http://localhost:3000
APP_URL=https://your-domain.com

# Salon Configuration
# Deprecated: Use نوبت‌آرا brand name instead
SALON_NAME=نوبت‌آرا

# Node Environment
NODE_ENV=production
